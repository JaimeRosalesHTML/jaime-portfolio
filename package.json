{
  "name": "jaime-rosales-portfolio",
  "version": "0.1.0",
  "private": true,
  "author": "Jaime Rosales <rosalesjaime000@gmail.com>",
  "description": "Personal portfolio website showcasing projects and skills as a Computer Science student",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaimeRosalesHTML/jaime-portfolio.git"
  },
  "homepage": "https://jaimerosales.dev",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "echo \"No tests specified\" && exit 0",
    "check": "npm run lint && npm run build",
    "git:add": "git add .",
    "git:commit": "git commit -m \"update\"",
    "git:push": "git push origin main",
    "git:update": "npm run git:add && npm run git:commit && npm run git:push",
    "deploy": "npm run build && npm run git:update"
  },
  "dependencies": {
    "next": "14.0.4",
    "react": "^18",
    "react-dom": "^18",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.294.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "postcss": "^8",
    "tailwindcss": "^3.3.0"
  }
} 